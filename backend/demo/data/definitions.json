[
  {
    "id": "antrag-pruefung",
    "name": "Antrag prüfen",
    "startStep": "daten_laden",
    "inputs": [
      {
        "name": "antrag_id",
        "label": "Antrag",
        "required": true,
        "beispiel": "A-1024"
      }
    ],
    "steps": {
      "daten_laden": {
        "type": "automatic",
        "action": "check_data",
        "config": {
          "entity": "antrag",
          "id": "{{antrag_id}}",
          "field": "status",
          "fields": [
            "betrag",
            "mail"
          ],
          "as": "antrag"
        },
        "transitions": [
          {
            "to": "pruefen",
            "when": "context['antrag_betrag'] > 1000"
          },
          {
            "to": "warten"
          }
        ]
      },
      "pruefen": {
        "type": "interactive",
        "ui": {
          "title": "Antrag prüfen",
          "description": "Bitte den Antrag prüfen.",
          "template": "antrag-info",
          "fields": [
            {
              "name": "antrag_betrag",
              "label": "Betrag",
              "type": "display"
            },
            {
              "name": "bemerkung",
              "label": "Bemerkung",
              "type": "text"
            },
            {
              "name": "geprueft",
              "label": "Unterlagen vollständig",
              "type": "boolean"
            },
            {
              "name": "beleg",
              "label": "Beleg",
              "type": "file",
              "handler": "pdf_max_5mb"
            }
          ]
        },
        "transitions": [
          {
            "to": "zusammenfassung",
            "event": "submit",
            "label": "Freigeben"
          },
          {
            "to": "abgelehnt",
            "event": "ablehnen",
            "label": "Ablehnen"
          }
        ]
      },
      "zusammenfassung": {
        "type": "interactive",
        "ui": {
          "title": "Zusammenfassung",
          "description": "Bitte die Angaben bestätigen.",
          "back": true,
          "fields": [
            {
              "name": "bemerkung",
              "label": "Bemerkung",
              "type": "display"
            },
            {
              "name": "geprueft",
              "label": "Unterlagen vollständig",
              "type": "display"
            }
          ]
        },
        "transitions": [
          {
            "to": "speichern",
            "event": "submit",
            "label": "Bestätigen"
          }
        ]
      },
      "abgelehnt": {
        "type": "automatic",
        "action": "send_email",
        "config": {
          "to": "{{antrag_mail}}",
          "subject": "Ihr Antrag {{antrag_id}} wurde abgelehnt"
        },
        "transitions": []
      },
      "warten": {
        "type": "timer",
        "delaySeconds": 3600,
        "transitions": [
          {
            "to": "speichern"
          }
        ]
      },
      "speichern": {
        "type": "automatic",
        "action": "write_data",
        "config": {
          "entity": "antrag",
          "id": "{{antrag_id}}",
          "values": {
            "status": "freigegeben",
            "geprueft_am": "{{now}}"
          },
          "as": "written"
        },
        "transitions": [
          {
            "to": "bestaetigung"
          }
        ]
      },
      "bestaetigung": {
        "type": "automatic",
        "action": "send_email",
        "config": {
          "to": "{{antrag_mail}}",
          "templateId": "antrag-ok"
        },
        "transitions": [
          {
            "to": "abschluss"
          }
        ]
      },
      "abschluss": {
        "type": "automatic",
        "action": "start_workflow",
        "config": {
          "workflowId": "archivierung"
        },
        "transitions": []
      }
    }
  },
  {
    "id": "mahnung",
    "name": "Mahnung",
    "draft": true,
    "startStep": "erinnern",
    "steps": {
      "erinnern": {
        "type": "timer",
        "delaySeconds": 604800,
        "transitions": [
          {
            "to": "mail"
          }
        ]
      },
      "mail": {
        "type": "automatic",
        "action": "send_email",
        "config": {
          "to": "{{mail}}",
          "subject": "Erinnerung"
        },
        "transitions": []
      }
    }
  },
  {
    "id": "archivierung",
    "name": "Archivierung",
    "startStep": "ablegen",
    "steps": {
      "ablegen": {
        "type": "automatic",
        "action": "send_email",
        "config": {
          "to": "archiv@example.org",
          "subject": "Archiv"
        },
        "transitions": []
      }
    }
  }
]
