{
    "name": "apollo29/workflow-engine-dev",
    "description": "Entwicklungs-Setup der Workflow-Engine (Tests, statische Analyse, Code-Style).",
    "type": "project",
    "license": "MIT",
    "require": {
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "php": ">=8.4",
        "psr/clock": "^1.0",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "symfony/expression-language": "^7.4",
        "symfony/http-client": "^7.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "WorkflowEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WorkflowEngine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        }
    }
}
